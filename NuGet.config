<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Everything this repository needs is on nuget.org. Pinning the sources here rather than
    inheriting whatever a machine happens to have configured makes a restore reproducible, and
    it is not hypothetical: a globally configured Stride feed timed out for 100 seconds per
    package and failed the build with NU1301, on packages it was never going to have.

    clear discards inherited sources rather than adding to them.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      VL.NetTopologySuite 0.0.7-alpha (the ICrsCatalog interface, 2026-11-12) until it is on nuget.org:
      the sibling repository's packed feed. pack.ps1 there writes it. Remove once 0.0.7-alpha is published.
    -->
    <add key="vl-nettopologysuite" value="..\vl-nettopologysuite\dist\feed" />
  </packageSources>
</configuration>
