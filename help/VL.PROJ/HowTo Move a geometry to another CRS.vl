            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Mhdx3Cd8jLVSop9l6zRBtl" Comment="" Bounds="60,175,470,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((154900 462900, 155100 462900, 155100 463100, 154900 463100, 154900 462900))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
